{
  "title": "With presence detection off, idle time never diverts a flash",
  "config": "[presence]\naway_after = \"0\"\n",
  "steps": [
    { "at": "0s", "hook": { "hook_event_name": "UserPromptSubmit", "session_id": "s1", "cwd": "/work/app" } },
    { "at": "2h", "idle": "2h", "hook": { "hook_event_name": "Stop", "session_id": "s1", "cwd": "/work/app" }, "expect": ["flash done"] }
  ]
}

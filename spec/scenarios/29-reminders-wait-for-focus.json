{
  "title": "Reminders wait while you are looking at a listed application",
  "config": "[flash]\nremind_after = \"10m\"\nskip_when_focused = [\"WindowsTerminal\"]\n",
  "steps": [
    { "at": "0s", "hook": { "hook_event_name": "UserPromptSubmit", "session_id": "s1", "cwd": "/work/app" } },
    {
      "at": "1m",
      "focused": "chrome",
      "hook": { "hook_event_name": "PermissionRequest", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "t1" },
      "expect": ["flash approval"]
    },
    { "at": "11m", "focused": "WindowsTerminal.exe", "tick": true, "expect": [] },
    {
      "at": "11m30s",
      "focused": "chrome",
      "note": "Focus moved on, and the reminder was still due",
      "tick": true,
      "expect": ["flash approval"]
    }
  ]
}

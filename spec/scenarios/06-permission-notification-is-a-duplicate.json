{
  "title": "A permission request and Claude Code's notification about it are one wait, in either order",
  "steps": [
    { "at": "0s", "hook": { "hook_event_name": "UserPromptSubmit", "session_id": "s1", "cwd": "/work/app" } },
    {
      "at": "1s",
      "hook": { "hook_event_name": "PermissionRequest", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "t1" },
      "expect": ["flash approval"]
    },
    {
      "at": "1200ms",
      "hook": { "hook_event_name": "Notification", "session_id": "s1", "cwd": "/work/app", "notification_type": "permission_prompt" },
      "expect": ["suppressed duplicate"],
      "waiting": 1
    },
    {
      "at": "3s",
      "hook": { "hook_event_name": "PostToolUse", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "t1" },
      "waiting": 0
    },
    {
      "at": "10s",
      "note": "This time the notification comes first",
      "hook": { "hook_event_name": "Notification", "session_id": "s1", "cwd": "/work/app", "notification_type": "permission_prompt" },
      "expect": ["flash approval"],
      "waiting": 1
    },
    {
      "at": "10500ms",
      "note": "The request adopts the notification's wait, giving it a tool_use_id",
      "hook": { "hook_event_name": "PermissionRequest", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "t2" },
      "expect": ["suppressed duplicate"],
      "waiting": 1
    },
    {
      "at": "12s",
      "hook": { "hook_event_name": "PostToolUse", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "t2" },
      "expect": [],
      "waiting": 0
    }
  ]
}

{
  "title": "Parallel permission requests are tracked, and resolved, separately",
  "steps": [
    { "at": "0s", "hook": { "hook_event_name": "UserPromptSubmit", "session_id": "s1", "cwd": "/work/app" } },
    {
      "at": "1s",
      "hook": { "hook_event_name": "PermissionRequest", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "a" },
      "expect": ["flash approval"],
      "waiting": 1
    },
    {
      "at": "1100ms",
      "note": "A second approval inside the flash interval is already covered by the flash that just played",
      "hook": { "hook_event_name": "PermissionRequest", "session_id": "s1", "cwd": "/work/app", "tool_name": "Write", "tool_use_id": "b" },
      "expect": [],
      "waiting": 2
    },
    {
      "at": "4s",
      "hook": { "hook_event_name": "PostToolUse", "session_id": "s1", "cwd": "/work/app", "tool_name": "Bash", "tool_use_id": "a" },
      "waiting": 1
    },
    {
      "at": "6s",
      "hook": { "hook_event_name": "PostToolUse", "session_id": "s1", "cwd": "/work/app", "tool_name": "Write", "tool_use_id": "b" },
      "waiting": 0
    }
  ]
}
